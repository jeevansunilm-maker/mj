# Copy this file to .env and edit.  (.env is git-ignored — never commit it.)

# Which AI answers by default: "ollama" (local, free, private) or "claude" (cloud)
AI_PROVIDER=ollama

# ── Local AI (Ollama) ─────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ── Cloud AI (Claude) — optional ──────────────────
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = smarter but slower and pricier)
CLAUDE_EFFORT=medium

# ── Server ────────────────────────────────────────
PORT=3000
# 127.0.0.1 = only this computer can open the app
HOST=127.0.0.1
