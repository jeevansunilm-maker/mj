# Copy this file to .env and edit.  (.env is git-ignored — never commit it.)

# Which AI answers by default: "ollama" (local, free, private) or "claude" (cloud)
AI_PROVIDER=ollama

# ── Local AI (Ollama) ─────────────────────────────
# http://localhost:11434/v1 also works
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ── Cloud AI (Claude) — optional ──────────────────
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = smarter but slower and pricier)
CLAUDE_EFFORT=medium
# Let Claude search the web and read results (on/off). Billed per search by Anthropic.
CLAUDE_WEB_SEARCH=on

# ── Voice: VoiceStudio app on this PC (see README → Natural voice) ──
# Default http://127.0.0.1:3900. Set to "off" to disable.
VOICESTUDIO_URL=
# Only if you turned on a login/key in VoiceStudio
VOICESTUDIO_API_KEY=

# ── Chat-app bots — optional (see README → Telegram / Discord) ──
# Only these user IDs can talk to the bot (comma-separated). Message the bot once to learn your ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=

# ── Google Sheets — optional (see README → Google Sheets) ──
# Default: data/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_FILE=

# ── Server ────────────────────────────────────────
PORT=3000
# 127.0.0.1 = only this computer can open the app
HOST=127.0.0.1
# Extra host names allowed in the address bar (advanced, comma-separated). Leave empty.
ALLOWED_HOSTS=
