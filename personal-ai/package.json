{
  "name": "personal-ai",
  "version": "1.5.0",
  "description": "A personal AI assistant: Node.js backend + plain HTML/CSS/JS frontend, powered by Claude.",
  "type": "module",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/src/server.js",
